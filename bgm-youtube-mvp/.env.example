# Copy to .env and fill in your values. Never commit .env.

# --- YouTube ---
# Path to the OAuth client secrets JSON you downloaded from Google Cloud Console
# (OAuth 2.0 Client IDs > Desktop app).
YOUTUBE_CLIENT_SECRETS=./client_secret.json
# Where the refresh token will be cached after the first browser-based login.
YOUTUBE_TOKEN_FILE=./token.json
# Default privacy when the pipeline uploads: private | unlisted | public
YOUTUBE_PRIVACY=private

# --- Generation ---
# Force a device, otherwise auto: cuda | mps | cpu (cpu is impractically slow)
DEVICE=cuda
# Hugging Face cache for MusicGen weights (optional)
HF_HOME=./.cache/huggingface

# --- Channel branding (used in title/description templates) ---
CHANNEL_NAME=Lofi Loop Studio
